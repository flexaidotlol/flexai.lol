---
import '../styles/global.css';
import { Navbar } from '../components/layout/Navbar';
import Footer from '../components/layout/Footer.astro';
import PostHog from '../components/posthog.astro';
import { recordVisitorHit } from '../lib/data/visitor-store';
import { hashVisitor } from '../lib/security';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  rank?: number;
  bidFormatted?: string;
}

const {
  title = 'flexai.lol',
  description = 'Founders bid to rank #1. Climb above competing AI products in real-time on FlexAI.',
  image = '/og-flexai.png',
  canonicalUrl = Astro.url.href,
  rank,
  bidFormatted,
} = Astro.props;

// Record real-time unique visitor hit immediately on SSR
try {
  const forwarded = Astro.request.headers.get('x-forwarded-for');
  const realIp = Astro.request.headers.get('x-real-ip');
  const cfIp = Astro.request.headers.get('cf-connecting-ip');
  const ip = (forwarded ? forwarded.split(',')[0].trim() : '') || realIp || cfIp || Astro.clientAddress || '127.0.0.1';
  const userAgent = Astro.request.headers.get('user-agent') || '';
  const visitorKey = hashVisitor(ip, userAgent);
  recordVisitorHit(visitorKey);
} catch {}

const currentPath = Astro.url.pathname;
const dynamicTitle = title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    {/* Inline script to default to light mode unless dark is explicitly saved */}
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    </script>

    {/* Primary Meta Tags */}
    <title>{dynamicTitle}</title>
    <meta name="title" content={dynamicTitle} />
    <meta name="description" content={description} />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={dynamicTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={dynamicTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    {/* Google Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />

    {/* PostHog Analytics */}
    <PostHog />
  </head>
  <body class="bg-slate-50 dark:bg-dark-950 text-slate-900 dark:text-gray-100 min-h-screen flex flex-col antialiased selection:bg-purple-500 selection:text-white transition-colors duration-150">
    {/* Ambient background glow (dark mode only) */}
    <div class="fixed inset-0 hidden dark:block bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.15),rgba(255,255,255,0))] pointer-events-none z-0"></div>

    <div class="relative z-10 flex-1 flex flex-col">
      <Navbar currentPath={currentPath} client:load />

      <slot />

      <Footer />
    </div>
  </body>
</html>
