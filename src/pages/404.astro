---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page Not Found — FlexAI.lol">
  <div class="max-w-xl mx-auto px-4 py-24 text-center space-y-4">
    <h1 class="text-6xl font-black text-slate-900 dark:text-white">404</h1>
    <h2 class="text-xl font-bold text-slate-700 dark:text-gray-200">This spot has not been flexed yet 💀</h2>
    <p class="text-sm text-slate-500 dark:text-gray-400">
      The page you're looking for doesn't exist or was outbid into oblivion.
    </p>
    <div class="pt-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-sm transition-all"
      >
        Back to Arena
      </a>
    </div>
  </div>
</Layout>
