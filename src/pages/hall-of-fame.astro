---
import Layout from '../layouts/Layout.astro';
import { getHallOfFame, getLeaderboard } from '../services/leaderboard';
import { centsToDollars } from '../lib/utils/format';
import { Trophy, Award, Crown, Flame, Sparkles, Medal, ExternalLink } from 'lucide-react';

export const prerender = false;

const [hallData, products] = await Promise.all([
  getHallOfFame(),
  getLeaderboard('all'),
]);

const top3 = products.slice(0, 3);
---

<Layout
  title="Hall of Fame & Historic Milestones — FlexAI.lol"
  description="Celebrate the legendary AI products and founders who unlocked historic bid records and took the throne on FlexAI."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    {/* Page Header */}
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-purple-500/20 text-purple-300 text-xs font-bold uppercase tracking-wider border border-purple-500/30">
        <Trophy className="w-4 h-4" />
        <span>Flex Arena Legends</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight">
        The Hall of Fame
      </h1>
      <p class="text-base sm:text-lg text-gray-300">
        Permanent records of products that reached milestone bids, climbed the highest, and held the #1 crown.
      </p>
    </div>

    {/* Podium Section */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-6">
      {top3[1] && (
        <div class="order-2 md:order-1 rounded-3xl bg-dark-900 border border-slate-400/30 p-6 flex flex-col items-center text-center relative overflow-hidden">
          <div class="w-14 h-14 rounded-2xl rank-badge-2 text-dark-950 font-black text-2xl flex items-center justify-center mb-4">
            #2
          </div>
          <img src={top3[1].logo_url} alt={top3[1].name} class="w-16 h-16 rounded-2xl object-cover mb-3" />
          <h3 class="text-xl font-bold text-white">{top3[1].name}</h3>
          <p class="text-xs text-gray-400 mt-1 line-clamp-1">{top3[1].tagline}</p>
          <div class="mt-4 text-2xl font-black text-white">{centsToDollars(top3[1].current_bid_cents)}</div>
          <a href={`/ai/${top3[1].slug}`} class="mt-4 text-xs text-purple-400 font-bold hover:underline">View Profile →</a>
        </div>
      )}

      {top3[0] && (
        <div class="order-1 md:order-2 rounded-3xl bg-gradient-to-b from-[#1c1838] to-[#0c0f24] border border-amber-500/50 shadow-glow-gold p-8 flex flex-col items-center text-center relative overflow-hidden -translate-y-2">
          <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-amber-400 via-purple-500 to-amber-400"></div>
          <Crown className="w-8 h-8 text-amber-400 mb-2 drop-shadow-[0_0_12px_rgba(245,158,11,0.8)]" />
          <div class="w-16 h-16 rounded-2xl rank-badge-1 text-dark-950 font-black text-3xl flex items-center justify-center mb-4 shadow-lg">
            #1
          </div>
          <img src={top3[0].logo_url} alt={top3[0].name} class="w-20 h-20 rounded-2xl object-cover mb-3" />
          <h3 class="text-2xl font-black text-white">{top3[0].name}</h3>
          <p class="text-xs text-gray-300 mt-1 line-clamp-1">{top3[0].tagline}</p>
          <div class="mt-4 text-3xl font-black text-amber-400">{centsToDollars(top3[0].current_bid_cents)}</div>
          <span class="text-xs font-semibold text-purple-300 uppercase tracking-wider mt-1">Reigning Champion</span>
          <a href={`/ai/${top3[0].slug}`} class="mt-4 px-6 py-2 rounded-xl text-xs font-bold text-white bg-purple-600 hover:bg-purple-500 shadow-glow-purple">
            Challenge Throne
          </a>
        </div>
      )}

      {top3[2] && (
        <div class="order-3 rounded-3xl bg-dark-900 border border-amber-700/30 p-6 flex flex-col items-center text-center relative overflow-hidden">
          <div class="w-14 h-14 rounded-2xl rank-badge-3 text-white font-black text-2xl flex items-center justify-center mb-4">
            #3
          </div>
          <img src={top3[2].logo_url} alt={top3[2].name} class="w-16 h-16 rounded-2xl object-cover mb-3" />
          <h3 class="text-xl font-bold text-white">{top3[2].name}</h3>
          <p class="text-xs text-gray-400 mt-1 line-clamp-1">{top3[2].tagline}</p>
          <div class="mt-4 text-2xl font-black text-white">{centsToDollars(top3[2].current_bid_cents)}</div>
          <a href={`/ai/${top3[2].slug}`} class="mt-4 text-xs text-purple-400 font-bold hover:underline">View Profile →</a>
        </div>
      )}
    </div>

    {/* All Achievements & Historic Records */}
    <div class="space-y-6">
      <div class="flex items-center justify-between border-b border-dark-border pb-4">
        <h2 class="text-2xl font-bold text-white flex items-center gap-2">
          <Medal className="w-6 h-6 text-purple-400" />
          <span>Milestone Badges</span>
        </h2>
        <span class="text-xs font-mono text-gray-400">All achievements are permanent</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {hallData.achievements.map((ach) => (
          <div class="rounded-2xl bg-dark-900 border border-dark-border p-6 space-y-3 relative overflow-hidden group hover:border-purple-500/40 transition-all">
            <div class="flex items-center justify-between">
              <div class="w-10 h-10 rounded-xl bg-purple-500/20 text-purple-300 flex items-center justify-center border border-purple-500/30">
                <Sparkles className="w-5 h-5" />
              </div>
              <span class="text-[11px] font-mono text-gray-400 uppercase tracking-wider">{ach.achievement_type}</span>
            </div>
            <div>
              <h3 class="text-lg font-bold text-white group-hover:text-purple-300 transition-colors">{ach.name}</h3>
              <p class="text-xs text-gray-400 mt-1">{ach.description}</p>
            </div>
            {ach.threshold_value && (
              <div class="text-xs font-mono text-emerald-400 font-semibold pt-2 border-t border-dark-border">
                Threshold: {centsToDollars(ach.threshold_value)}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
